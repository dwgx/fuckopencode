# fuckopencode 环境变量模板
#
# 复制为 .env 后按需修改：
#   cp .env.example .env
#
# 约定：注释格式为「用途（默认值；示例）」。多数变量不设即用默认值，
# 默认值均与 src/config.ts 实际解析一致，改动以代码为准。
# 必填项仅一组：调用方鉴权 key + 至少一个上游 key，其余全有默认值。

## 一、必填：鉴权与上游 key

# 调用方鉴权 key，逗号分隔多个。空则 fail-closed 拒绝所有请求
# （可用面板 settings 热改覆盖）。示例：API_KEYS=demo-key,another-key
API_KEYS=demo-key

# 上游 key 池，逗号分隔多个；与 ANTHROPIC_API_KEY 合并去重，单 key 排最前。
# 示例：OPENSEA_KEYS=sk-ant-a,sk-ant-b
# OPENSEA_KEYS 与 ANTHROPIC_API_KEY 至少配一个，否则所有请求 503（零上游 key）。
OPENSEA_KEYS=

# 上游单 key（并入 key 池；与 OPENSEA_KEYS 等价，按习惯二选一或都用）。
ANTHROPIC_API_KEY=sk-ant-your-upstream-key

## 二、服务

# 监听地址（默认 127.0.0.1）。
HOST=127.0.0.1

# 监听端口（默认 8787）。独立部署默认 8787；如果前面挂了盾/反代（网关只被本机
# 盾访问），通常绑 127.0.0.1 换端口。示例：PORT=8788
PORT=8787

## 三、数据面与安全

# 提示词注入检测（默认 block）：block=高置信命中拒 400 / log=只记录 / off=关闭。
INJECTION_MODE=block

# 未鉴权放行开关（默认 0）。仅当绑定回环地址（127.0.0.1/localhost/::1）时生效，
# 绑定非回环地址强制要求鉴权——fail-closed，防止裸奔到局域网/公网。
ALLOW_UNAUTHENTICATED=0

# 请求体字节上限（默认 67108864 = 64MB；0 = 不限）。
# 公网部署建议设 33554432（32MB）：认证客户端的超大请求体是内存 DoS 面。
MAX_BODY_BYTES=67108864

# 数据面并发在飞上限（/v1/chat/completions + /v1/messages，默认 400）。
# 超限 503 + Retry-After；0 = 不限（不推荐，曾是该进程唯一 OOM 向量）。
MAX_CONCURRENT_REQUESTS=400

# messages 条数上限（默认 4000，防超长列表遍历 DoS；0 = 不限）。
MAX_MESSAGES=4000

# 单条消息文本字符上限（默认 8000000；DeepSeek V4 是 1M token 上下文，需留余量；
# 0 = 不限）。
MAX_MESSAGE_CHARS=8000000

# 日志/转发内容里的控制符是否剥离（默认 1）。
STRIP_CONTROL_CHARS=1

# 是否透传客户端 x-claude-code-* 会话标记头（默认 0；共享部署防冒充会话）。
TRUST_CLAUDE_CODE_HEADERS=0

# 监控面板本机直连免 key（默认 0）。仅绑定回环地址时生效（fail-closed）；
# 面板含调用方 IP/UA 等设备信息，绑非回环时即使开着也必须带 key 才能看。
DASHBOARD_OPEN=0

# 面板是否完全公开（含公网，默认 0）。打开后任何人都能看到全部调用方的 IP、
# 完整 UA、转发链——公开面板的隐私取舍，仅「把面板当展示页」时开。
DASHBOARD_PUBLIC=0

## 四、用量与 key 池

# 用量库路径（默认 data/usage.db，相对启动目录）。空串 = 关闭持久化，
# 面板只剩内存窗口，代理行为不变。
USAGE_DB_PATH=data/usage.db

# 用量/审计记录保留天数（默认 30；0 = 不清理）。
USAGE_DB_RETENTION_DAYS=30

# key 池连续失败多少次禁用（默认 5）。
KEY_FAIL_THRESHOLD=5

# key 冷却期 ms（默认 300000 = 5 分钟）。
KEY_COOLDOWN_MS=300000

# key 主动探活周期 ms（默认 900000 = 15 分钟；0 = 关闭）。
KEY_PROBE_INTERVAL_MS=900000

# key 空闲多久才值得探活 ms（默认 3600000 = 60 分钟；有真实流量经过就不额外探）。
KEY_PROBE_IDLE_MS=3600000

# 单次探活请求超时 ms（默认 30000）。
KEY_PROBE_TIMEOUT_MS=30000

# 上游模型目录刷新周期 ms（默认 21600000 = 6 小时；0 = 仅启动拉一次）。
MODEL_CATALOG_REFRESH_MS=21600000

# billing 余额抓取周期 ms（默认 1800000 = 30 分钟；0 = 关闭循环）。
BILLING_INTERVAL_MS=1800000

# 单次 billing 抓取超时 ms（默认 20000）。
BILLING_TIMEOUT_MS=20000

## 五、管理面

# 面板登录账号（默认 admin）。
ADMIN_USER=admin

# 面板登录密码（默认 13141516）。使用默认值时有 adminPassIsDefault 徽章 +
# stderr 告警——生产必须改为强密码。
ADMIN_PASS=13141516

# 面板会话 cookie 有效期 ms（默认 86400000 = 24 小时）。
ADMIN_SESSION_TTL_MS=86400000

# 同 IP 登录失败 N 次后锁定（默认 5）。
ADMIN_LOGIN_FAIL_LIMIT=5

# 登录锁定时长 ms（默认 300000 = 5 分钟）。
ADMIN_LOGIN_LOCK_MS=300000

# 管理面加密密钥（AES-256-GCM 材料，默认空）。非空时优先于 SECRET_FILE，
# 用于加密账户 key 与 billing cookie。生产建议显式设置长随机串。
GATEWAY_SECRET=

# secret 文件路径（默认 data/secret.key，不存在自动生成 0600）。
# 丢失 = 账户 key/billing cookie 永久不可解，必须随 data/ 目录一起备份。
SECRET_FILE=data/secret.key

## 六、OAuth/控制台

# OAuth device flow 的 client_id（默认 opencode-cli，官方 CLI 同款）。
OAUTH_CLIENT_ID=opencode-cli

# OAuth 控制台端点 base URL（默认 https://console.opencode.ai，末尾斜杠自动剥）。
OAUTH_CONSOLE_URL=https://console.opencode.ai

# 订阅端点 base URL（默认 https://opencode.ai/zen/go，末尾斜杠自动剥；cost=0）。
ANTHROPIC_BASE_URL=https://opencode.ai/zen/go

# 按量付费端点 base URL（默认 https://opencode.ai/zen；-free 模型只存在于这里）。
PAYG_BASE_URL=https://opencode.ai/zen

# 模型名映射表（OpenAI 名 -> 上游 Anthropic 名），逗号分隔多对。
# 示例：MODEL_MAP="gpt-4o:deepseek-v4-flash,gpt-4o-mini:deepseek-v4-flash"
# 映射结果必须在白名单内，否则明确 400。
MODEL_MAP=

# 请求缺省模型名时的兜底（默认 deepseek-v4-flash；仅缺省回落，白名单外不静默回落）。
DEFAULT_MODEL=deepseek-v4-flash

## 七、实验性（默认全关；开启即接受失真/丢字）

# 返回给客户端的 usage 是否缩放（默认 0）。诱导 Claude Code 按假用量提前本地
# compact，从源头避免撞上游 400；代价是客户端看到的用量失真。
SCALE_CLIENT_TOKENS=0

# usage 缩放系数（默认 0.6657，范围 (0, 1]）。
CLIENT_TOKEN_SCALE=0.6657

# 请求体被动压缩开关（默认 0）。超 COMPACT_TRIGGER_BYTES 时空白折叠 +
# 超长单条截断，无损（不裁剪消息）。
COMPACT_ENABLED=0

# 被动压缩触发阈值，请求体字节数（默认 4194304 = 4MB）。
COMPACT_TRIGGER_BYTES=4194304

# 被动压缩的单条消息字符上限，超长截断（默认 8000）。
COMPACT_MAX_MESSAGE_CHARS=8000

## 八、OTA 自更新（默认全关，fail-closed）

# 总开关（默认 0）。0 = 面板只读状态照常、perform 写盘+自重启 403；
# 1 = 允许从 GitHub release 下载 dist tarball 并自动更新。
# 第三方部署注意：自重启需要 supervisor（systemd/launchd）托管，裸跑前台进程时
# perform 会拒绝；且你的仓库必须先配好 release.yml 再开。
OTA_ENABLED=0

# 更新源仓库 owner/repo（默认 dwgx/fuckopencode）。
# 第三方部署注意：fork 后必须改成你自己的 owner/repo，且你的仓库要配好
# .github/workflows/release.yml（push tag vX.Y.Z 触发 typecheck+test+build+
# 打包 dist tarball + 算 sha256 + 上传 release 资产），否则 OTA 拉不到资产。
OTA_REPO=dwgx/fuckopencode

# 私有仓库 token（默认空）。配了只走直连、不交给 gh-proxy，永不进日志/响应。
OTA_TOKEN=

# 后台版本检查周期 ms（默认 21600000 = 6 小时；0 = 关闭，只检查不自动应用）。
OTA_CHECK_INTERVAL_MS=21600000
